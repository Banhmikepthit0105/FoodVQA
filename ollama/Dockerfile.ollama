# Base image with CUDA support (for GPU), or use debian/ubuntu if CPU only
FROM nvidia/cuda:12.2.2-base-ubuntu22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV OLLAMA_HOST=0.0.0.0

# Install dependencies
RUN apt-get update && \
    apt-get install -y curl gnupg unzip git build-essential libssl-dev && \
    rm -rf /var/lib/apt/lists/*

# Install Ollama
RUN curl -fsSL https://ollama.com/install.sh | sh

# Expose Ollama default port
EXPOSE 11434

# Pull the specific model (optional; can also be pulled at runtime)
RUN ollama pull llama3.2-vision:11b-instruct-fp16

# Start Ollama server and run the model (modify as needed)
CMD ["ollama", "serve"]